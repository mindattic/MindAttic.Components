<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plain `dotnet test` for the engine-free Core (net10 NUnit, globs Runtime/Core). The Core sources are
    compiled straight into this assembly from the Unity package, so the code Unity imports is the code
    tested here. Core.Build compiles the same sources as netstandard2.1 / C# 9 first.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MindAttic.Components.Unity.Core.Tests</AssemblyName>
    <RootNamespace>MindAttic.Components.Unity.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\com.mindattic.components.unity\Runtime\Core\**\*.cs" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Build\Core.Build.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

</Project>
