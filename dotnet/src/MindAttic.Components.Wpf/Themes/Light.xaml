<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:MindAttic.Components.Wpf.Controls">

    <!-- The MindAttic light palette (M.COMP-T53): the same keys as Theme.xaml's dark palette, at the
         same contrast standard. Don't merge it by hand: ctl:MaTheme.Set(MaThemeMode.Light) merges it
         just after Theme.xaml, so it wins over the dark brushes and loses to an app's own re-keyed ones
         (and to ctl:MaHighContrast, which writes the dictionary's own entries). Every style refers to
         these keys as DynamicResource, so every control follows live. Ratios are WCAG 2.2 contrast on
         MaChrome / MaSurface. -->
    <ctl:MaThemeMode x:Key="MaThemeMode">Light</ctl:MaThemeMode>

    <!-- Backgrounds: a light grey chrome with white raised surfaces. -->
    <SolidColorBrush x:Key="MaChrome" Color="#FFF3F4F7" />
    <SolidColorBrush x:Key="MaSurface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MaHover" Color="#FFE6E8EE" />
    <SolidColorBrush x:Key="MaHoverStrong" Color="#FFDADDE5" />
    <!-- Decorative rule, like the dark one (1.2:1). -->
    <SolidColorBrush x:Key="MaChromeBorder" Color="#FFDCDFE6" />

    <!-- Text: 15.0 / 16.5:1 and muted 6.1 / 6.7:1. -->
    <SolidColorBrush x:Key="MaText" Color="#FF1E1F24" />
    <SolidColorBrush x:Key="MaMuted" Color="#FF595C66" />
    <!-- Red as text or a mark: 5.1 / 5.6:1. -->
    <SolidColorBrush x:Key="MaRec" Color="#FFC42B2B" />
    <!-- A favourite star: 4.1 / 4.5:1 (a mark, 3:1 needed). -->
    <SolidColorBrush x:Key="MaStar" Color="#FFA66A00" />

    <!-- The accent is the same blue (white on it is 5.7:1; on the hover 7.5:1). -->
    <SolidColorBrush x:Key="MaAccent" Color="#FF3B5BDB" />
    <SolidColorBrush x:Key="MaAccentHover" Color="#FF2F4AB8" />
    <SolidColorBrush x:Key="MaOnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MaTileHover" Color="#FF3B5BDB" />
    <SolidColorBrush x:Key="MaAccentBorder" Color="#FF2F4AB8" />
    <SolidColorBrush x:Key="MaAccentDisabled" Color="#FFC9D1EA" />
    <SolidColorBrush x:Key="MaOnAccentDisabled" Color="#FF5C6680" />

    <!-- Outlines: a control 3.2:1 on MaChrome, a text field 4.6 / 5.1:1, keyboard focus 5.4 / 6.0:1. -->
    <SolidColorBrush x:Key="MaControlBorder" Color="#FF868993" />
    <SolidColorBrush x:Key="MaFieldBorder" Color="#FF6B6E78" />
    <SolidColorBrush x:Key="MaFocus" Color="#FF1E5BD6" />
    <SolidColorBrush x:Key="MaDisabledText" Color="#FF8A8D96" />

    <!-- Status colours, deepened for a light ground: good 4.9 / 5.4:1, warning 5.0 / 5.5:1, bad 5.1 / 5.6:1,
         other 5.7 / 6.2:1. -->
    <SolidColorBrush x:Key="MaGood" Color="#FF1B7A43" />
    <SolidColorBrush x:Key="MaWarn" Color="#FFA65200" />
    <SolidColorBrush x:Key="MaBad" Color="#FFC42B2B" />
    <SolidColorBrush x:Key="MaOther" Color="#FF7041D1" />
    <!-- Link text: 6.8 / 7.5:1. -->
    <SolidColorBrush x:Key="MaLink" Color="#FF2F4AB8" />
    <!-- Chart gridlines: 3.0 / 3.3:1. -->
    <SolidColorBrush x:Key="MaChartGrid" Color="#FF8A8D96" />
    <!-- MaModal's dimmed backdrop, a little lighter over a light page. -->
    <SolidColorBrush x:Key="MaBackdrop" Color="#73000000" />
</ResourceDictionary>
