<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PackageId>MindAttic.Components.Wpf</PackageId>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>15.0.0</Version>
    <Description>Shared WPF theme (dark chrome palette, tool/text button, pin toggle, themed
      dropdown menu styles), a DropdownMenu control (a themed, pinnable action menu that closes
      its own popup before invoking an action, so it's never on screen for a screenshot or the
      start of a recording), and an AddressBar control: a themed Back/Forward/Reload(/Home) +
      URL bar attachable to a CoreWebView2 that can change at runtime, with an optional
      navigation guard a host can use to veto any action. McWindow.DarkTitleBar asks Windows to
      draw a window's title bar dark to match the theme. McModal is an in-window modal dialog
      (dimmed backdrop, themed card with a heading, close button and footer) opened through a
      bindable IsOpen, closed by Esc or a backdrop click, with focus trapped inside and returned
      on close. McProgressBar styles a ProgressBar as a thin rounded track with a coloured fill,
      determinate or indeterminate. McBadge is a small outlined pill (an optional icon-font glyph
      and a word in a state colour) with a plain McTag variant for a type or category label.
      Building blocks: McPillChoice (a single-choice pill row), McPillToggle, McCard,
      McStatCard/McSmallStat tiles, the McFocusRing keyboard focus ring, McHeading/McSectionLabel/
      McMutedText text styles, and McLineChart, a themed percent-over-time line chart (time and
      percent axes, reference lines, per-point segment colours, a dotted projection).
      McToast is a themed notification card (accent stripe, a title and two-line body
      that is one clickable button, a dismiss button), and McToastHost a row that stacks them
      from a bound collection and announces each new one politely to screen readers.
      McHyperlink styles a Hyperlink in text: the McLink accent, SemiBold, underlined only on hover
      and keyboard focus.
      McTextBox.Placeholder shows muted placeholder text in an empty McTextBox, and McTextArea is
      the multi-line text box whose thin themed scroll bars show when its text overflows.
      McMessageBox.Show is a themed stand-in for MessageBox (a dark-title-bar window with an icon,
      the message and OK / OK-Cancel / Yes-No / Yes-No-Cancel buttons, returning MessageBoxResult)
      for prompts when no app window is open to host an McModal.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
  </ItemGroup>

</Project>
