<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PackageId>MindAttic.Components.Wpf</PackageId>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>3.0.0</Version>
    <Description>Shared WPF theme (dark chrome palette, tool/text button, pin toggle, themed
      dropdown menu styles) and a DropdownMenu control: a themed, pinnable action menu that
      closes its own popup before invoking an action, so it's never on screen for a screenshot
      or the start of a recording.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
