<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:MindAttic.Components.Wpf.Controls">

    <!-- The MindAttic dark chrome palette. Merge this dictionary into Application.Resources (or a
         Window's) to pick up every style below, plus an implicit dark ToolTip for the whole app. -->
    <SolidColorBrush x:Key="McChrome" Color="#FF1E1F24" />
    <SolidColorBrush x:Key="McChromeBorder" Color="#FF34363E" />
    <SolidColorBrush x:Key="McText" Color="#FFE6E6EA" />
    <SolidColorBrush x:Key="McMuted" Color="#FF9A9CA6" />
    <SolidColorBrush x:Key="McRec" Color="#FFE5484D" />
    <SolidColorBrush x:Key="McStar" Color="#FFF5C542" />
    <SolidColorBrush x:Key="McAccent" Color="#FF3B5BDB" />
    <SolidColorBrush x:Key="McAccentHover" Color="#FF2F4AB8" />
    <!-- A raised surface (text boxes, bordered buttons) and the hover tint over chrome. -->
    <SolidColorBrush x:Key="McSurface" Color="#FF2A2C33" />
    <SolidColorBrush x:Key="McHover" Color="#FF2D2F37" />
    <!-- Control outlines: 3.1:1 against McChrome, the WCAG 1.4.11 minimum for a component boundary. -->
    <SolidColorBrush x:Key="McControlBorder" Color="#FF6A6C75" />
    <!-- Keyboard focus. Every templated control below restores a focus visual, because replacing
         the default template throws the system one away. -->
    <SolidColorBrush x:Key="McFocus" Color="#FF7AB8FF" />
    <!-- McTileButton's hover fill. An app can re-key this in its own resources (e.g. a brand
         colour) without restyling the tile. -->
    <SolidColorBrush x:Key="McTileHover" Color="#FF3B5BDB" />
    <!-- Status colours for data (chart segments, state dots): good, warning and bad. McBad is
         4.9:1 or better on every surface here, where McRec's #E5484D is 3.6:1 on a card. -->
    <SolidColorBrush x:Key="McGood" Color="#FF2FBF71" />
    <SolidColorBrush x:Key="McWarn" Color="#FFF5A524" />
    <SolidColorBrush x:Key="McBad" Color="#FFFF7A7D" />
    <!-- McHyperlink's text: the accent hue lightened for reading, 5.6:1 on McChrome and 4.9:1 on
         McSurface (McAccent itself is a fill colour, under 3:1 as text). -->
    <SolidColorBrush x:Key="McLink" Color="#FF7A93F0" />
    <!-- McLineChart's gridlines and hour ticks. -->
    <SolidColorBrush x:Key="McChartGrid" Color="#FF696969" />

    <!-- A 34x34 icon-font button (Segoe Fluent Icons / Segoe MDL2 Assets) with a flat hover highlight
         and a dimmed disabled state. Used for toolbar-style icon buttons. -->
    <Style x:Key="McToolButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource McText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource McHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource McFocus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A pill-shaped text button (dialog actions: Save / Cancel / Browse...). -->
    <Style x:Key="McTextButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource McText}" />
        <Setter Property="Background" Value="{StaticResource McHover}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Centred by default; set HorizontalContentAlignment="Left" for a fill-width text or link button (M.COMP-T36). -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource McFocus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A bordered dark button: the general-purpose command button (toolbars, command bars, a
         splash screen's retry). -->
    <Style x:Key="McButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource McText}" />
        <Setter Property="Background" Value="{StaticResource McSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource McControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource McHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource McMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource McFocus}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource McChrome}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource McChromeBorder}" />
                            <Setter Property="Foreground" Value="#FF7A7C85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one emphasized action on a screen. Background and McAccentHover can be re-keyed by an
         app that needs a brand colour (e.g. a LinkedIn-blue Apply). -->
    <Style x:Key="McPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource McButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource McAccent}" />
        <Setter Property="BorderBrush" Value="#FF8FA3F0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource McAccentHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#FF3A4A5C" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3A4A5C" />
                            <Setter Property="Foreground" Value="#FF9AA7B4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A large launcher-style tile: content (usually a title plus a McTileSubtitle) on a bordered
         card that fills with McTileHover on hover. -->
    <Style x:Key="McTileButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Background" Value="{StaticResource McSurface}" />
        <Setter Property="Foreground" Value="{StaticResource McText}" />
        <Setter Property="BorderBrush" Value="{StaticResource McControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="16,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource McTileHover}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource McTileHover}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource McFocus}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A tile's second line. Muted at rest; follows the tile's hover up to white so it stays
         readable on the hover fill. -->
    <Style x:Key="McTileSubtitle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource McMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Foreground" Value="White" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A 2px keyboard focus ring in McFocus (6.7:1 on a card), drawn just outside the control. Set
         it as FocusVisualStyle on any control whose own template doesn't show keyboard focus well;
         the system default is a black dotted line, invisible on the dark chrome. -->
    <Style x:Key="McFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{StaticResource McFocus}" BorderThickness="2" CornerRadius="7" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text styles. A heading is one screen readers list and jump between (WCAG 1.3.1); a section
         label is the small muted heading over a group; muted text is secondary, trimmed to fit. -->
    <Style x:Key="McHeading" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="McSectionLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
        <Setter Property="Foreground" Value="{StaticResource McMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>

    <Style x:Key="McMutedText" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource McMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A link inside text (a ticket id, a doc reference): McLink, SemiBold, no underline at rest
         and underlined on hover and on keyboard focus, so focus shows without relying on colour
         alone (WCAG 1.4.1 / 2.4.7). Set Command/CommandParameter or NavigateUri per use; a
         BasedOn style can add them, e.g. the Orchestrator's ticket links (M.COMP-T35). -->
    <Style x:Key="McHyperlink" TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{StaticResource McLink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource McMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A card: a raised, bordered surface that groups related content. -->
    <Style x:Key="McCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource McSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource McChromeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- A stat tile: McTileButton sized for a big value over a caption (a summary card a click acts
         on, e.g. filtering to that group), with the focus ring. -->
    <Style x:Key="McStatCard" TargetType="{x:Type Button}" BasedOn="{StaticResource McTileButton}">
        <Setter Property="Height" Value="74" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Padding" Value="14,0,18,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource McFocusRing}" />
    </Style>

    <!-- McStatCard's small variant: no size or margin of its own (the panel holding a row of them
         sizes each and the gaps), and its tooltip doubles as its accessible help text, so a
         keyboard or screen-reader user gets what a mouse user reads on hover. -->
    <Style x:Key="McSmallStat" TargetType="{x:Type Button}" BasedOn="{StaticResource McStatCard}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="14,0,16,0" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- A pill: the rounded chip McPillChoice's items and McPillToggle share. Hover tints it, keyboard
         focus outlines it in McFocus, and the chosen/on state fills it with McAccent. -->
    <Style x:Key="McPillChoice" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Foreground" Value="{StaticResource McText}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource McFocusRing}" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="Bd" Background="{StaticResource McChrome}" BorderBrush="{StaticResource McControlBorder}"
                                        BorderThickness="1" CornerRadius="14" Padding="14,5" Margin="0,0,6,6">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource McHover}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource McFocus}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource McAccent}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource McAccent}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="McPillToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{StaticResource McText}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource McFocusRing}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd" Background="{StaticResource McSurface}" BorderBrush="{StaticResource McControlBorder}"
                            BorderThickness="1" CornerRadius="14" Padding="14,5">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource McHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource McFocus}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource McAccent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource McAccent}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dark single-line text box with hover and focus outlines. -->
    <Style x:Key="McTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{StaticResource McSurface}" />
        <Setter Property="Foreground" Value="{StaticResource McText}" />
        <Setter Property="BorderBrush" Value="{StaticResource McChromeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource McText}" />
        <Setter Property="SelectionBrush" Value="{StaticResource McAccent}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource McControlBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource McFocus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small icon-font toggle (pin/unpin) meant to sit inside a McDropdownMenuItem's header. -->
    <Style x:Key="McPinToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FF363842" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dark, bordered dropdown shell. Pair with McDropdownMenuItem for the items inside it. -->
    <Style x:Key="McDropdownMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{StaticResource McChrome}" />
        <Setter Property="Foreground" Value="{StaticResource McText}" />
        <Setter Property="BorderBrush" Value="{StaticResource McChromeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dropdown row: a stretched header (so a trailing pin glyph lands flush right regardless of
         label length) plus a muted InputGestureText column, dimmed when disabled. -->
    <Style x:Key="McDropdownMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource McText}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource McMuted}"
                                       Margin="16,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource McHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="McSeparator" TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{StaticResource McChromeBorder}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,4" />
    </Style>

    <!-- A thin rounded progress bar: a McSurface track outlined in McControlBorder, filled in the
         bar's Foreground (McAccent unless the host sets or binds one, e.g. a budget colour that
         turns amber then red). Determinate fills Value's share of Minimum..Maximum from the left;
         IsIndeterminate sweeps a segment across the track instead, for work with no known end.
         6px tall by default; set Height for a thicker bar. -->
    <Style x:Key="McProgressBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{StaticResource McAccent}" />
        <Setter Property="Background" Value="{StaticResource McSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource McControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border x:Name="TrackBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2"
                                    HorizontalAlignment="Left" />
                            <!-- The indeterminate sweep: the fill colour seen through a moving opaque band
                                 of the opacity mask, so it needs no width of its own. -->
                            <Border x:Name="IndeterminateFill" Background="{TemplateBinding Foreground}" CornerRadius="2"
                                    Visibility="Collapsed">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-0.4" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Offset="0" Color="Transparent" />
                                        <GradientStop Offset="0.04" Color="Black" />
                                        <GradientStop Offset="0.36" Color="Black" />
                                        <GradientStop Offset="0.4" Color="Transparent" />
                                        <GradientStop Offset="1" Color="Transparent" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateFill" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Sweep">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateFill"
                                                         Storyboard.TargetProperty="(Border.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.4" To="1" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="Sweep" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- McModal's backdrop: McChrome's near-black at 60%, dimming whatever is behind the card. -->
    <SolidColorBrush x:Key="McBackdrop" Color="#99000000" />

    <!-- Implicit: the look of every Controls.McModal. A dimmed backdrop (PART_Backdrop) fills the
         host; on it a centred card (PART_Card) with a drop shadow drawn by a sibling border, so the
         card's own text isn't rendered through the effect. The title is a level-2 heading; the
         close button (PART_CloseButton) sits in the header but comes last in the tree, so tab order
         runs content, footer, close. -->
    <Style TargetType="{x:Type ctl:McModal}">
        <Setter Property="Foreground" Value="{StaticResource McText}" />
        <Setter Property="Background" Value="{StaticResource McChrome}" />
        <Setter Property="BorderBrush" Value="{StaticResource McChromeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,4,20,20" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Panel.ZIndex" Value="1000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:McModal}">
                    <Grid>
                        <Border x:Name="PART_Backdrop" Background="{DynamicResource McBackdrop}" />
                        <Grid MaxWidth="{TemplateBinding DialogWidth}" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="PART_Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"
                                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                                    KeyboardNavigation.DirectionalNavigation="Contained">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="TitleText" Grid.Row="0" Text="{TemplateBinding Title}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="20,14,52,10"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                    </ScrollViewer>
                                    <Border x:Name="FooterArea" Grid.Row="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0"
                                            Padding="20,12">
                                        <ContentPresenter Content="{TemplateBinding Footer}" HorizontalAlignment="Right" />
                                    </Border>
                                    <Button x:Name="PART_CloseButton" Grid.Row="0" Style="{StaticResource McToolButton}" Content="&#xE711;"
                                            FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                            AutomationProperties.Name="Close" ToolTip="Close" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterArea" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: the look of every Controls.McBadge, a small outlined pill: an optional icon-font
         glyph (PART_Glyph, collapsed when Glyph is empty, hidden from UI Automation by the
         control's automation peer) then the content, all in Foreground, the state colour. The
         outline follows Foreground unless BorderBrush is set. -->
    <Style TargetType="{x:Type ctl:McBadge}">
        <Setter Property="Foreground" Value="{StaticResource McText}" />
        <Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:McBadge}">
                    <Border x:Name="PART_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PART_Glyph" Text="{TemplateBinding Glyph}" FontFamily="{TemplateBinding GlyphFontFamily}"
                                       FontSize="{TemplateBinding GlyphFontSize}" FontWeight="Normal" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="">
                            <Setter TargetName="PART_Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="PART_Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- McBadge's plain tag variant: a squarer, quieter label (a type or category) with a neutral
         outline and normal-weight 11px text, e.g. a subagent's type. -->
    <Style x:Key="McTag" TargetType="{x:Type ctl:McBadge}" BasedOn="{StaticResource {x:Type ctl:McBadge}}">
        <Setter Property="BorderBrush" Value="{StaticResource McControlBorder}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Implicit: the look of every Controls.McToast. A McSurface card outlined in its Accent with
         a 4px Accent stripe on the left; the title and a two-line body are one borderless button
         (PART_OpenButton, focus ring in McFocus), and a McToolButton (x) on the right dismisses it
         (PART_DismissButton, named "Dismiss: {Title}"). -->
    <Style TargetType="{x:Type ctl:McToast}">
        <Setter Property="Foreground" Value="{StaticResource McText}" />
        <Setter Property="Background" Value="{StaticResource McSurface}" />
        <Setter Property="Accent" Value="{StaticResource McAccent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="340" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:McToast}">
                    <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Accent}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border x:Name="AccentStripe" DockPanel.Dock="Left" Width="4" Background="{TemplateBinding Accent}"
                                    CornerRadius="5,0,0,5" />
                            <Button x:Name="PART_DismissButton" DockPanel.Dock="Right" Style="{StaticResource McToolButton}"
                                    Content="&#xE711;" FontSize="10" VerticalAlignment="Top" Margin="0,4,4,0" ToolTip="Dismiss"
                                    AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, StringFormat='Dismiss: {0}'}" />
                            <Button x:Name="PART_OpenButton" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    AutomationProperties.Name="{TemplateBinding Title}"
                                    AutomationProperties.HelpText="{TemplateBinding Body}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Ring" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                CornerRadius="4" Margin="2">
                                            <ContentPresenter Margin="9,7,2,7" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource McFocus}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                                    <!-- Exactly two 16px lines, then clipped with an ellipsis. -->
                                    <TextBlock x:Name="BodyText" Text="{TemplateBinding Body}" Foreground="{StaticResource McMuted}"
                                               FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="32" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Body" Value="">
                            <Setter TargetName="BodyText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: every Controls.McToastHost. A wrapping row of toasts (so full-width ones stack)
         plus a hidden polite live region (PART_Announcer) that reads each new toast out. -->
    <Style TargetType="{x:Type ctl:McToastHost}">
        <Setter Property="AutomationProperties.Name" Value="Notifications" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:McToastHost}">
                    <Grid>
                        <ItemsPresenter />
                        <TextBlock x:Name="PART_Announcer" Width="0" Height="0" Opacity="0" IsHitTestVisible="False"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: every ToolTip in an app that merges this dictionary gets the dark chrome look
         automatically, with no per-ToolTip Style reference needed. -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{StaticResource McChrome}" />
        <Setter Property="Foreground" Value="{StaticResource McText}" />
        <Setter Property="BorderBrush" Value="{StaticResource McChromeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
