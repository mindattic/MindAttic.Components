<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:MindAttic.Components.Wpf.Controls">

    <!-- The MindAttic dark chrome palette, the default theme. Merge this dictionary into Application.Resources
         (or a Window's) to pick up every style below, plus an implicit ToolTip for the whole app.
         ctl:MaTheme.Set(MaThemeMode.Light) merges Themes/Light.xaml (the same keys in light colours) over
         it, live, and MaThemeMode.Dark takes it back out (M.COMP-T53).
         Every style references these brushes as DynamicResource, so an app can re-key one in its own
         resources (which win over a merged dictionary) and every library control follows, live; that
         is how ctl:MaHighContrast swaps in the Windows high-contrast colours (M.COMP-T11). -->
    <SolidColorBrush x:Key="MaChrome" Color="#FF1E1F24" />
    <SolidColorBrush x:Key="MaChromeBorder" Color="#FF34363E" />
    <SolidColorBrush x:Key="MaText" Color="#FFE6E6EA" />
    <SolidColorBrush x:Key="MaMuted" Color="#FF9A9CA6" />
    <!-- Recording/alert red, as text or a mark: 4.9:1 or better on every surface here (WCAG 1.4.3;
         it was #E5484D, 3.6:1 on a card, which every app had to override, M.COMP-T11). The same red as MaBad. -->
    <SolidColorBrush x:Key="MaRec" Color="#FFFF7A7D" />
    <SolidColorBrush x:Key="MaStar" Color="#FFF5C542" />
    <SolidColorBrush x:Key="MaAccent" Color="#FF3B5BDB" />
    <SolidColorBrush x:Key="MaAccentHover" Color="#FF2F4AB8" />
    <!-- Text and marks drawn on an MaAccent fill (a primary button, a chosen pill, a hovered tile). -->
    <SolidColorBrush x:Key="MaOnAccent" Color="#FFFFFFFF" />
    <!-- A raised surface (text boxes, bordered buttons) and the hover tint over chrome. -->
    <SolidColorBrush x:Key="MaSurface" Color="#FF2A2C33" />
    <SolidColorBrush x:Key="MaHover" Color="#FF2D2F37" />
    <!-- Control outlines: 3.1:1 against MaChrome, the WCAG 1.4.11 minimum for a component boundary. -->
    <SolidColorBrush x:Key="MaControlBorder" Color="#FF6A6C75" />
    <!-- A text field's outline, which shows where to type: 4.9:1 on MaChrome and 4.2:1 on MaSurface
         (WCAG 1.4.11 asks 3:1). MaChromeBorder, its old outline, is a decorative 1.2:1 (M.COMP-T11). -->
    <SolidColorBrush x:Key="MaFieldBorder" Color="#FF8A8C96" />
    <!-- Keyboard focus. Every templated control below restores a focus visual, because replacing
         the default template throws the system one away. -->
    <SolidColorBrush x:Key="MaFocus" Color="#FF7AB8FF" />
    <!-- MaTileButton's hover fill. An app can re-key this in its own resources (e.g. a brand
         colour) without restyling the tile. -->
    <SolidColorBrush x:Key="MaTileHover" Color="#FF3B5BDB" />
    <!-- Status colours for data (chart segments, state dots): good, warning and bad. MaBad is
         4.9:1 or better on every surface here (MaRec is now the same red). -->
    <SolidColorBrush x:Key="MaGood" Color="#FF2FBF71" />
    <SolidColorBrush x:Key="MaWarn" Color="#FFF5A524" />
    <SolidColorBrush x:Key="MaBad" Color="#FFFF7A7D" />
    <!-- The fourth status: anything that's neither good, warning nor bad (idle, waiting, unknown).
         Purple, 6.4:1 on MaChrome and 5.3:1 on MaSurface (M.COMP-T50). -->
    <SolidColorBrush x:Key="MaOther" Color="#FFB48CFF" />
    <!-- MaHyperlink's text: the accent hue lightened for reading, 5.6:1 on MaChrome and 4.9:1 on
         MaSurface (MaAccent itself is a fill colour, under 3:1 as text). -->
    <SolidColorBrush x:Key="MaLink" Color="#FF7A93F0" />
    <!-- MaLineChart's gridlines and hour ticks: 3.1:1 on MaChrome (it was #696969, just under 3:1; M.COMP-T53). -->
    <SolidColorBrush x:Key="MaChartGrid" Color="#FF6B6B6B" />
    <!-- A stronger hover tint (MaPinToggle inside a highlighted menu item). -->
    <SolidColorBrush x:Key="MaHoverStrong" Color="#FF363842" />
    <!-- A disabled MaButton's text (disabled controls are exempt from WCAG contrast). -->
    <SolidColorBrush x:Key="MaDisabledText" Color="#FF7A7C85" />
    <!-- MaPrimaryButton's outline, and its fill and text while disabled. -->
    <SolidColorBrush x:Key="MaAccentBorder" Color="#FF8FA3F0" />
    <SolidColorBrush x:Key="MaAccentDisabled" Color="#FF3A4A5C" />
    <SolidColorBrush x:Key="MaOnAccentDisabled" Color="#FF9AA7B4" />
    <!-- Which palette is in force: Dark here, Light while ctl:MaTheme merges Themes/Light.xaml over this
         dictionary (M.COMP-T53). MaThemeToggle and MaWindow.ThemedTitleBar follow it. -->
    <ctl:MaThemeMode x:Key="MaThemeMode">Dark</ctl:MaThemeMode>

    <!-- A 34x34 icon-font button (Segoe Fluent Icons / Segoe MDL2 Assets) with a flat hover highlight
         and a dimmed disabled state. Used for toolbar-style icon buttons. -->
    <Style x:Key="MaToolButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MaHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A pill-shaped text button (dialog actions: Save / Cancel / Browse...). -->
    <Style x:Key="MaTextButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="Background" Value="{DynamicResource MaHover}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Centred by default; set HorizontalContentAlignment="Left" for a fill-width text or link button (M.COMP-T36). -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A bordered dark button: the general-purpose command button (toolbars, command bars, a
         splash screen's retry). -->
    <Style x:Key="MaButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="Background" Value="{DynamicResource MaSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaChrome}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaChromeBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaDisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one emphasized action on a screen. Background and MaAccentHover can be re-keyed by an
         app that needs a brand colour (e.g. a LinkedIn-blue Apply). -->
    <Style x:Key="MaPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaButton}">
        <Setter Property="Foreground" Value="{DynamicResource MaOnAccent}" />
        <Setter Property="Background" Value="{DynamicResource MaAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaAccentBorder}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaAccentHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaOnAccent}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaAccentDisabled}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaAccentDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaOnAccentDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A large launcher-style tile: content (usually a title plus a MaTileSubtitle) on a bordered
         card that fills with MaTileHover on hover. ctl:MaTile.IsSelected outlines it 2px in
         ctl:MaTile.SelectedBrush (MaFocus unless set) for a chosen tile, e.g. a stat filtering the page
         (M.COMP-T52); every tile style below is based on it, so they all have it. -->
    <Style x:Key="MaTileButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Background" Value="{DynamicResource MaSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaControlBorder}" />
        <Setter Property="ctl:MaTile.SelectedBrush" Value="{DynamicResource MaFocus}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="16,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource MaTileHover}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource MaTileHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ctl:MaTile.IsSelected" Value="True">
                <Setter Property="BorderBrush" Value="{Binding Path=(ctl:MaTile.SelectedBrush), RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A tile's second line. Muted at rest; follows the tile's hover up to white so it stays
         readable on the hover fill. -->
    <Style x:Key="MaTileSubtitle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MaMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MaOnAccent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A 2px keyboard focus ring in MaFocus (6.7:1 on a card), drawn just outside the control. Set
         it as FocusVisualStyle on any control whose own template doesn't show keyboard focus well;
         the system default is a black dotted line, invisible on the dark chrome. -->
    <Style x:Key="MaFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{DynamicResource MaFocus}" BorderThickness="2" CornerRadius="7" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text styles. A heading is one screen readers list and jump between (WCAG 1.3.1); a section
         label is the small muted heading over a group; muted text is secondary, trimmed to fit. -->
    <Style x:Key="MaHeading" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="MaSectionLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
        <Setter Property="Foreground" Value="{DynamicResource MaMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>

    <Style x:Key="MaMutedText" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MaMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A link inside text (a ticket id, a doc reference): MaLink, SemiBold, no underline at rest
         and underlined on hover and on keyboard focus, so focus shows without relying on colour
         alone (WCAG 1.4.1 / 2.4.7). Set Command/CommandParameter or NavigateUri per use; a
         BasedOn style can add them, e.g. the Orchestrator's ticket links (M.COMP-T35). -->
    <Style x:Key="MaHyperlink" TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{DynamicResource MaLink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource MaMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A card: a raised, bordered surface that groups related content. -->
    <Style x:Key="MaCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource MaSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaChromeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- A stat tile: MaTileButton sized for a big value over a caption (a summary card a click acts
         on, e.g. filtering to that group), with the focus ring. -->
    <Style x:Key="MaStatCard" TargetType="{x:Type Button}" BasedOn="{StaticResource MaTileButton}">
        <Setter Property="Height" Value="74" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Padding" Value="14,0,18,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MaFocusRing}" />
    </Style>

    <!-- MaStatCard's small variant: no size or margin of its own (the panel holding a row of them
         sizes each and the gaps), and its tooltip doubles as its accessible help text, so a
         keyboard or screen-reader user gets what a mouse user reads on hover. -->
    <Style x:Key="MaSmallStat" TargetType="{x:Type Button}" BasedOn="{StaticResource MaStatCard}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="14,0,16,0" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- A pill: the rounded chip MaPillChoice's items and MaPillToggle share. Hover tints it, keyboard
         focus outlines it in MaFocus, and the chosen/on state fills it with MaAccent. -->
    <Style x:Key="MaPillChoice" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Foreground" Value="{DynamicResource MaText}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource MaFocusRing}" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="Bd" Background="{DynamicResource MaChrome}" BorderBrush="{DynamicResource MaControlBorder}"
                                        BorderThickness="1" CornerRadius="14" Padding="14,5" Margin="0,0,6,6">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaHover}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaAccent}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaAccent}" />
                                        <Setter Property="Foreground" Value="{DynamicResource MaOnAccent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MaPillToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MaFocusRing}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd" Background="{DynamicResource MaSurface}" BorderBrush="{DynamicResource MaControlBorder}"
                            BorderThickness="1" CornerRadius="14" Padding="14,5">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaAccent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaOnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A thin dark scroll bar: a MaControlBorder thumb (MaMuted while hovered, MaText while
         dragged) on a clear track, no arrow buttons. The text box styles below use it as is; the
         implicit ScrollBar style further down bases on it with a MaChrome track, so every other
         scroll bar in the app looks the same (M.COMP-T37). -->
    <Style x:Key="MaScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bd" Background="{DynamicResource MaControlBorder}" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaMuted}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MaScrollBarPage" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MaScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Border Background="{TemplateBinding Background}" Padding="2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource MaScrollBarPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource MaScrollBarPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource MaScrollBarThumb}" MinHeight="16" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Border Background="{TemplateBinding Background}" Padding="2">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource MaScrollBarPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource MaScrollBarPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource MaScrollBarThumb}" MinWidth="16" />
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A dark single-line text box with hover and focus outlines. ctl:MaTextBox.Placeholder shows
         muted text while it's empty (not hit-testable, not part of the accessible name). Its
         scroll bars follow the box's own HorizontalScrollBarVisibility/VerticalScrollBarVisibility
         (Hidden here), so setting either on a box shows a thin MaScrollBar. -->
    <Style x:Key="MaTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource MaSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaFieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource MaText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource MaAccent}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <Border.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource MaScrollBar}" />
                        </Border.Resources>
                        <Grid Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding ctl:MaTextBox.Placeholder}"
                                       Foreground="{DynamicResource MaMuted}" Margin="2,0" IsHitTestVisible="False"
                                       Visibility="Collapsed" TextWrapping="{TemplateBinding TextWrapping}"
                                       TextTrimming="CharacterEllipsis" TextAlignment="{TemplateBinding TextAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaText}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A multi-line MaTextBox: Enter adds a line, text wraps and starts at the top, and a thin
         MaScrollBar shows whenever the text overflows. Set TextWrapping="NoWrap" for a log; the
         horizontal bar then shows for long lines. Give it a Height (or a row to fill). -->
    <Style x:Key="MaTextArea" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaTextBox}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- A small icon-font toggle (pin/unpin) meant to sit inside a MaDropdownMenuItem's header. -->
    <Style x:Key="MaPinToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MaHoverStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dark, bordered dropdown shell. Pair with MaDropdownMenuItem for the items inside it. -->
    <Style x:Key="MaDropdownMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource MaChrome}" />
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaChromeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dropdown row: a stretched header (so a trailing pin glyph lands flush right regardless of
         label length) plus a muted InputGestureText column, dimmed when disabled. -->
    <Style x:Key="MaDropdownMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource MaMuted}"
                                       Margin="16,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MaHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MaSeparator" TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MaChromeBorder}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,4" />
    </Style>

    <!-- A thin rounded progress bar: a MaSurface track outlined in MaControlBorder, filled in the
         bar's Foreground (MaAccent unless the host sets or binds one, e.g. a budget colour that
         turns amber then red). Determinate fills Value's share of Minimum..Maximum from the left;
         IsIndeterminate sweeps a segment across the track instead, for work with no known end.
         6px tall by default; set Height for a thicker bar. -->
    <Style x:Key="MaProgressBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource MaAccent}" />
        <Setter Property="Background" Value="{DynamicResource MaSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border x:Name="TrackBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2"
                                    HorizontalAlignment="Left" />
                            <!-- The indeterminate sweep: the fill colour seen through a moving opaque band
                                 of the opacity mask, so it needs no width of its own. -->
                            <Border x:Name="IndeterminateFill" Background="{TemplateBinding Foreground}" CornerRadius="2"
                                    Visibility="Collapsed">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-0.4" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Offset="0" Color="Transparent" />
                                        <GradientStop Offset="0.04" Color="Black" />
                                        <GradientStop Offset="0.36" Color="Black" />
                                        <GradientStop Offset="0.4" Color="Transparent" />
                                        <GradientStop Offset="1" Color="Transparent" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateFill" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Sweep">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateFill"
                                                         Storyboard.TargetProperty="(Border.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.4" To="1" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="Sweep" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MaModal's backdrop: MaChrome's near-black at 60%, dimming whatever is behind the card. -->
    <SolidColorBrush x:Key="MaBackdrop" Color="#99000000" />

    <!-- Implicit: the look of every Controls.MaModal. A dimmed backdrop (PART_Backdrop) fills the
         host; on it a centred card (PART_Card) with a drop shadow drawn by a sibling border, so the
         card's own text isn't rendered through the effect. The title is a level-2 heading; the
         close button (PART_CloseButton) sits in the header but comes last in the tree, so tab order
         runs content, footer, close. -->
    <Style TargetType="{x:Type ctl:MaModal}">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="Background" Value="{DynamicResource MaChrome}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaChromeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,4,20,20" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Panel.ZIndex" Value="1000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:MaModal}">
                    <Grid>
                        <Border x:Name="PART_Backdrop" Background="{DynamicResource MaBackdrop}" />
                        <Grid MaxWidth="{TemplateBinding DialogWidth}" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="PART_Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"
                                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                                    KeyboardNavigation.DirectionalNavigation="Contained">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="TitleText" Grid.Row="0" Text="{TemplateBinding Title}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="20,14,52,10"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                    </ScrollViewer>
                                    <Border x:Name="FooterArea" Grid.Row="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0"
                                            Padding="20,12">
                                        <ContentPresenter Content="{TemplateBinding Footer}" HorizontalAlignment="Right" />
                                    </Border>
                                    <Button x:Name="PART_CloseButton" Grid.Row="0" Style="{StaticResource MaToolButton}" Content="&#xE711;"
                                            FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                            AutomationProperties.Name="Close" ToolTip="Close" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterArea" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: the look of every Controls.MaBadge, a small outlined pill: an optional icon-font
         glyph (PART_Glyph, collapsed when Glyph is empty, hidden from UI Automation by the
         control's automation peer) then the content, all in Foreground, the state colour. The
         outline follows Foreground unless BorderBrush is set. -->
    <Style TargetType="{x:Type ctl:MaBadge}">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:MaBadge}">
                    <Border x:Name="PART_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PART_Glyph" Text="{TemplateBinding Glyph}" FontFamily="{TemplateBinding GlyphFontFamily}"
                                       FontSize="{TemplateBinding GlyphFontSize}" FontWeight="Normal" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="">
                            <Setter TargetName="PART_Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="PART_Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: every Controls.MaSpinner (the busy ring that turns on its own thread, so it keeps
         turning while the UI thread is blocked) draws in MaAccent unless the host sets Stroke. -->
    <Style TargetType="{x:Type ctl:MaSpinner}">
        <Setter Property="Stroke" Value="{DynamicResource MaAccent}" />
    </Style>

    <!-- MaBadge's plain tag variant: a squarer, quieter label (a type or category) with a neutral
         outline and normal-weight 11px text, e.g. a subagent's type. -->
    <Style x:Key="MaTag" TargetType="{x:Type ctl:MaBadge}" BasedOn="{StaticResource {x:Type ctl:MaBadge}}">
        <Setter Property="BorderBrush" Value="{DynamicResource MaControlBorder}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Implicit: every Controls.MaThemeToggle, an MaToolButton showing its Glyph (a sun in dark mode,
         a moon in light mode) with its SwitchText ("Switch to light theme") as the tooltip. M.COMP-T53. -->
    <Style TargetType="{x:Type ctl:MaThemeToggle}" BasedOn="{StaticResource MaToolButton}">
        <Setter Property="Content" Value="{Binding Glyph, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ToolTip" Value="{Binding SwitchText, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- Implicit: every Controls.MaStatusLight, an 8px dot filled with the theme brush for its
         Status (Good MaGood, Warning MaWarn, Bad MaBad, Other MaOther); its tooltip is its
         Description (the label, or the status word). M.COMP-T50. -->
    <Style TargetType="{x:Type ctl:MaStatusLight}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource MaOther}" />
        <Setter Property="ToolTip" Value="{Binding Description, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:MaStatusLight}">
                    <Ellipse x:Name="PART_Dot" Fill="{TemplateBinding Foreground}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Status" Value="Good">
                <Setter Property="Foreground" Value="{DynamicResource MaGood}" />
            </Trigger>
            <Trigger Property="Status" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource MaWarn}" />
            </Trigger>
            <Trigger Property="Status" Value="Bad">
                <Setter Property="Foreground" Value="{DynamicResource MaBad}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Implicit: every Controls.MaTabControl, a tab strip over its content. The tabs sit in a
         TabPanel (PART_HeaderPanel: Tab enters once, Left/Right cycle) on a MaChromeBorder rule; the
         selected tab's content (PART_SelectedContentHost) fills the rest, collapsed when
         ShowContent is false. M.COMP-T50. -->
    <Style TargetType="{x:Type ctl:MaTabControl}">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaChromeBorder}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:MaTabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="ContentRow" Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource MaChromeBorder}" BorderThickness="0,0,0,1">
                            <TabPanel x:Name="PART_HeaderPanel" IsItemsHost="True" Background="Transparent"
                                      KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <Border x:Name="ContentArea" Grid.Row="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowContent" Value="False">
                            <Setter TargetName="ContentArea" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentRow" Property="Height" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: every Controls.MaTabItem. A flat MaMuted label on the chrome: an optional
         MaStatusLight (PART_StatusLight, collapsed while Status is null), the header, then the
         Trailing text in TrailingForeground (PART_Trailing, 11px, collapsed while empty). Hover
         tints it MaHover; the selected tab lifts onto MaSurface in MaText with a 2px underline in
         its own Accent (PART_Underline); keyboard focus draws MaFocusRing. M.COMP-T50. -->
    <Style TargetType="{x:Type ctl:MaTabItem}">
        <Setter Property="Foreground" Value="{DynamicResource MaMuted}" />
        <Setter Property="Accent" Value="{DynamicResource MaAccent}" />
        <Setter Property="TrailingForeground" Value="{DynamicResource MaMuted}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MaFocusRing}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:MaTabItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ctl:MaStatusLight x:Name="PART_StatusLight" Margin="0,0,7,0"
                                                   Status="{Binding Status, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:Static ctl:MaStatus.Other}}"
                                                   Label="{TemplateBinding StatusLabel}" />
                                <ContentPresenter x:Name="HeaderHost" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock x:Name="PART_Trailing" Text="{TemplateBinding Trailing}" Foreground="{TemplateBinding TrailingForeground}"
                                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="PART_Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="1"
                                Background="{TemplateBinding Accent}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Status" Value="{x:Null}">
                            <Setter TargetName="PART_StatusLight" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Trailing" Value="{x:Null}">
                            <Setter TargetName="PART_Trailing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Trailing" Value="">
                            <Setter TargetName="PART_Trailing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaSurface}" />
                            <Setter TargetName="PART_Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource MaText}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: the look of every Controls.MaToast. A MaSurface card outlined in its Accent with
         a 4px Accent stripe on the left; the title and a two-line body are one borderless button
         (PART_OpenButton, focus ring in MaFocus), and a MaToolButton (x) on the right dismisses it
         (PART_DismissButton, named "Dismiss: {Title}"). -->
    <Style TargetType="{x:Type ctl:MaToast}">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="Background" Value="{DynamicResource MaSurface}" />
        <Setter Property="Accent" Value="{DynamicResource MaAccent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="340" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:MaToast}">
                    <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Accent}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border x:Name="AccentStripe" DockPanel.Dock="Left" Width="4" Background="{TemplateBinding Accent}"
                                    CornerRadius="5,0,0,5" />
                            <Button x:Name="PART_DismissButton" DockPanel.Dock="Right" Style="{StaticResource MaToolButton}"
                                    Content="&#xE711;" FontSize="10" VerticalAlignment="Top" Margin="0,4,4,0" ToolTip="Dismiss"
                                    AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, StringFormat='Dismiss: {0}'}" />
                            <Button x:Name="PART_OpenButton" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    AutomationProperties.Name="{TemplateBinding Title}"
                                    AutomationProperties.HelpText="{TemplateBinding Body}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Ring" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                CornerRadius="4" Margin="2">
                                            <ContentPresenter Margin="9,7,2,7" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                                    <!-- Exactly two 16px lines, then clipped with an ellipsis. -->
                                    <TextBlock x:Name="BodyText" Text="{TemplateBinding Body}" Foreground="{DynamicResource MaMuted}"
                                               FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="32" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Body" Value="">
                            <Setter TargetName="BodyText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: every Controls.MaToastHost. A wrapping row of toasts (so full-width ones stack)
         plus a hidden polite live region (PART_Announcer) that reads each new toast out. -->
    <Style TargetType="{x:Type ctl:MaToastHost}">
        <Setter Property="AutomationProperties.Name" Value="Notifications" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:MaToastHost}">
                    <Grid>
                        <ItemsPresenter />
                        <TextBlock x:Name="PART_Announcer" Width="0" Height="0" Opacity="0" IsHitTestVisible="False"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: every ScrollBar (M.COMP-T37). MaScrollBar's slim MaControlBorder thumb on a
         MaChrome track, so every scroll bar in an app that merges this dictionary (list boxes,
         scroll viewers, MaModal's body) is dark instead of the light system bar. MaTextBox and
         MaTextArea keep MaScrollBar's clear track over their own MaSurface. -->
    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource MaScrollBar}">
        <Setter Property="Background" Value="{DynamicResource MaChrome}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Implicit: every ScrollViewer. The stock layout (content, then the two scroll bars) with the
         square where they meet (Corner) filled MaChrome instead of the system control colour. -->
    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Rectangle x:Name="Corner" Grid.Column="1" Grid.Row="1" Fill="{DynamicResource MaChrome}" />
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" Grid.Row="0"
                                                Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                CanHorizontallyScroll="False" CanVerticallyScroll="False" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0" Cursor="Arrow"
                                   AutomationProperties.AutomationId="VerticalScrollBar" Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1" Cursor="Arrow" Orientation="Horizontal"
                                   AutomationProperties.AutomationId="HorizontalScrollBar" Minimum="0"
                                   Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== Page building blocks (M.COMP-T52): scroll areas, lists, cards and tiles, so a dashboard needs no raw
         ScrollViewer, ItemsControl or Border of its own. ==== -->

    <!-- A page body that scrolls: vertical only, not a tab stop, its content padded by ctl:MaScrollArea.Gutter
         (24,0,24,16: the window's 24px side gutters). While the vertical bar shows it sits inside the right gutter
         instead of pushing the content in, so the cards still end where the header and toolbar end. Based on the
         implicit ScrollViewer (dark corner and scroll bars). Set the gutter, not Padding. -->
    <Style x:Key="MaBodyScroll" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ctl:MaScrollArea.Gutter" Value="24,0,24,16" />
        <Setter Property="Padding">
            <Setter.Value>
                <MultiBinding Converter="{x:Static ctl:MaScrollArea.PaddingConverter}">
                    <Binding Path="(ctl:MaScrollArea.Gutter)" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="ComputedVerticalScrollBarVisibility" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MaBodyScroll for a side pane (a detail pane beside the body): a 20px gutter all round. -->
    <Style x:Key="MaPaneScroll" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource MaBodyScroll}">
        <Setter Property="ctl:MaScrollArea.Gutter" Value="20,16,20,20" />
    </Style>

    <!-- Lists for an ItemsControl. None is a tab stop (its items are); each lays its items out in a library panel set
         from ctl:MaList on the list. MaList: a plain vertical list, no gaps (ctl:MaList.Spacing to add one). -->
    <Style x:Key="MaList" TargetType="{x:Type ItemsControl}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ctl:MaList.Spacing" Value="0" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <ctl:MaStackPanel Spacing="{Binding Path=(ctl:MaList.Spacing), RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical rows 8px apart (ctl:MaList.Spacing), none after the last: a list of cards (MaListCard / MaRowCard). -->
    <Style x:Key="MaRowList" TargetType="{x:Type ItemsControl}" BasedOn="{StaticResource MaList}">
        <Setter Property="ctl:MaList.Spacing" Value="8" />
    </Style>

    <!-- A wrap of tiles in an MaTileGrid, 10px apart both ways (ctl:MaList.Spacing / RowSpacing). With
         ctl:MaList.MinItemWidth the tiles sit in equal columns that fill the width (UniformRows, Balanced too);
         without, they flow at their own widths and wrap. Use MaListCard / MaAccentCard / MaAccentTile items. -->
    <Style x:Key="MaTileList" TargetType="{x:Type ItemsControl}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ctl:MaList.Spacing" Value="10" />
        <Setter Property="ctl:MaList.RowSpacing" Value="10" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <ctl:MaTileGrid Spacing="{Binding Path=(ctl:MaList.Spacing), RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    RowSpacing="{Binding Path=(ctl:MaList.RowSpacing), RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    MinItemWidth="{Binding Path=(ctl:MaList.MinItemWidth), RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    UniformRows="{Binding Path=(ctl:MaList.UniformRows), RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    Balanced="{Binding Path=(ctl:MaList.Balanced), RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cards for a list's items: MaCard without its bottom margin, since the list owns the gaps. -->
    <Style x:Key="MaListCard" TargetType="{x:Type Border}" BasedOn="{StaticResource MaCard}">
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- A dense table-like row (columns of id, repo, summary, actions): MaListCard with 10,8 padding. -->
    <Style x:Key="MaRowCard" TargetType="{x:Type Border}" BasedOn="{StaticResource MaListCard}">
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- A card that leads with an MaAccentBar running to its edges: MaListCard with no padding (pad the content). -->
    <Style x:Key="MaAccentCard" TargetType="{x:Type Border}" BasedOn="{StaticResource MaListCard}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- A panel inside a card (a card's own sub-list): sunk onto MaChrome, 10,8 padding, 10px below what's above. -->
    <Style x:Key="MaInsetCard" TargetType="{x:Type Border}" BasedOn="{StaticResource MaCard}">
        <Setter Property="Background" Value="{DynamicResource MaChrome}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <!-- A colour bar down a card's left edge (a state or a person's colour; a cue, never the only one): 5px, docked
         left, rounded to fit an MaAccentCard's corners. MaAccent unless Background is set. -->
    <Style x:Key="MaAccentBar" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="5" />
        <Setter Property="DockPanel.Dock" Value="Left" />
        <Setter Property="CornerRadius" Value="5,0,0,5" />
        <Setter Property="Background" Value="{DynamicResource MaAccent}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A translucent veil over a card while it's locked (e.g. a move in flight): MaSurface at 82%, the card's corners.
         Put it, and a spinner with words, in a Grid over the card's content. Set CornerRadius="0" over a row. -->
    <Style x:Key="MaVeil" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource MaSurface}" />
        <Setter Property="Opacity" Value="0.82" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- A side pane beside the body (a detail pane): the window's MaChrome, set off by an MaChromeBorder rule on its
         left. Give it a Width and an MaPaneScroll. -->
    <Style x:Key="MaSidePane" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource MaChrome}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaChromeBorder}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>

    <!-- The window's status bar: an MaChromeBorder rule along its top, 24,6 padding (the window's side gutters). -->
    <Style x:Key="MaStatusBar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaChromeBorder}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="24,6" />
    </Style>

    <!-- A 1px MaChromeBorder rule between two groups (decorative: not in the UI Automation content view). Set
         Width="1" and Height="Auto" (and a Margin) for a vertical one. -->
    <Style x:Key="MaDivider" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource MaChromeBorder}" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- A cover over the whole window (a first-load loader): opaque MaChrome on top of every row. Span every row and
         column; bind its Visibility, and name it (AutomationProperties.Name, LiveSetting) for screen readers. -->
    <Style x:Key="MaCover" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource MaChrome}" />
        <Setter Property="Panel.ZIndex" Value="100" />
    </Style>

    <!-- A stat tile's big number: 24px SemiBold with tabular figures, so a changing count doesn't jitter. Pair it with
         an MaTileSubtitle caption on an MaStatCard / MaSmallStat; set Foreground for a state colour. -->
    <Style x:Key="MaStatValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Implicit: every Controls.MaAccentTile. MaTileButton (hover fill, focus outline, ctl:MaTile.IsSelected) with a
         4px bar in its Accent (PART_AccentBar, AccentWidth) down the left edge and its content padded inside it. No
         width or margin of its own (an MaTileList sizes and spaces the tiles); at least 64px tall. -->
    <Style TargetType="{x:Type ctl:MaAccentTile}" BasedOn="{StaticResource MaTileButton}">
        <Setter Property="Accent" Value="{DynamicResource MaAccent}" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MaFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:MaAccentTile}">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border x:Name="PART_AccentBar" DockPanel.Dock="Left" Width="{TemplateBinding AccentWidth}"
                                    Background="{TemplateBinding Accent}" CornerRadius="3,0,0,3" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource MaTileHover}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource MaTileHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: every Controls.MaPicker. Closed, a MaSurface box outlined in MaFieldBorder (MaText on hover, 2px
         MaFocus with keyboard focus): the chosen option's status light (PART_SelectedStatusLight), its name, its muted
         trailing text (PART_SelectedTrailing) and a chevron, or the muted Placeholder (PART_Placeholder) while nothing
         is chosen. Open, an MaChrome list of MaPickerItems under it (PART_Popup). -->
    <Style TargetType="{x:Type ctl:MaPicker}">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="Background" Value="{DynamicResource MaSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaFieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="IsEditable" Value="False" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:MaPicker}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsTabStop="False"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <DockPanel Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" Foreground="{DynamicResource MaMuted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="PART_SelectedTrailing" DockPanel.Dock="Right" Text="{TemplateBinding SelectedTrailing}"
                                       Foreground="{DynamicResource MaMuted}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular" />
                            <ctl:MaStatusLight x:Name="PART_SelectedStatusLight" DockPanel.Dock="Left" Margin="0,0,8,0"
                                               Status="{Binding SelectedStatus, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:Static ctl:MaStatus.Other}}"
                                               Label="{TemplateBinding SelectedStatusLabel}" />
                            <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <TextBlock x:Name="PART_Placeholder" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource MaMuted}"
                                           TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                <ContentPresenter x:Name="SelectionBox" Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                        </DockPanel>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="False" PopupAnimation="None"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="DropDown" Background="{DynamicResource MaChrome}" BorderBrush="{DynamicResource MaChromeBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0" SnapsToDevicePixels="True"
                                    MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="False" Focusable="False">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedStatus" Value="{x:Null}">
                            <Setter TargetName="PART_SelectedStatusLight" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SelectedTrailing" Value="{x:Null}">
                            <Setter TargetName="PART_SelectedTrailing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SelectedTrailing" Value="">
                            <Setter TargetName="PART_SelectedTrailing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource MaText}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                            <Setter TargetName="Toggle" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: every Controls.MaPickerItem. The name in MaText, led by an optional MaStatusLight (PART_StatusLight,
         collapsed while Status is null) and followed by the muted Trailing text (PART_Trailing, collapsed while empty).
         Highlighted: MaHover; keyboard focus: an MaFocus outline; chosen: SemiBold with a 3px MaAccent bar at the left
         (PART_SelectedBar). -->
    <Style TargetType="{x:Type ctl:MaPickerItem}">
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="TrailingForeground" Value="{DynamicResource MaMuted}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:MaPickerItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <TextBlock x:Name="PART_Trailing" DockPanel.Dock="Right" Text="{TemplateBinding Trailing}"
                                           Foreground="{TemplateBinding TrailingForeground}" FontSize="11" FontWeight="Normal"
                                           Margin="16,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                <ctl:MaStatusLight x:Name="PART_StatusLight" DockPanel.Dock="Left" Margin="0,0,8,0"
                                                   Status="{Binding Status, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:Static ctl:MaStatus.Other}}"
                                                   Label="{TemplateBinding StatusLabel}" />
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </DockPanel>
                        </Border>
                        <Border x:Name="PART_SelectedBar" Width="3" HorizontalAlignment="Left" Margin="1,7" CornerRadius="1.5"
                                Background="{DynamicResource MaAccent}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Status" Value="{x:Null}">
                            <Setter TargetName="PART_StatusLight" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Trailing" Value="{x:Null}">
                            <Setter TargetName="PART_Trailing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Trailing" Value="">
                            <Setter TargetName="PART_Trailing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MaFocus}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_SelectedBar" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: every ToolTip in an app that merges this dictionary gets the dark chrome look
         automatically, with no per-ToolTip Style reference needed (MindAttic.Orchestrator and
         MindAttic.Tickets.Desktop both rely on this one now, rather than a local copy of their own). -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource MaChrome}" />
        <Setter Property="Foreground" Value="{DynamicResource MaText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaChromeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
